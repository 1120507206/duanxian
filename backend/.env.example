# ── 运行环境 ────────────────────────────────────────────────
# PM2 / start.sh 会设置 NODE_ENV=production；手动运行时再按需取消注释。
# NODE_ENV=production
PORT=8080
# 生产环境请改成真实前端域名。留 * 会让任意站点都能调用 API。
CORS_ORIGIN=https://your-domain.com

# ── 涨停播报 ────────────────────────────────────────────────
ZTLIVE_SOURCE_URL=https://ds.duanxianxia.com/vendor/stockdata/ztlive_all.json
# 需要 Node 22+；设为 0 可关闭封板事件流，页面自动退回纯快照轮询。
ZTLIVE_WS_ENABLED=1
ZTLIVE_WS_URL=wss://m.duanxianxia.com/wss3
ZTLIVE_WS_FALLBACK_URL=wss://ws.duanxianxia.com/wss3
# 事件流是否只发给会员（0 = 公开，1 = 仅会员）
ZTLIVE_STREAM_REQUIRE_MEMBER=0
ZTLIVE_STREAM_MAX_CLIENTS=500

# ── 账号 / 短信验证码 ───────────────────────────────────────
# 默认关闭短信验证码（手机号 + 密码注册）；配好短信通道后可设为 1 恢复验证码流程。
REQUIRE_SMS_CODE=0
# console = 不真发，验证码只写日志；tencent = 腾讯云 SMS；webhook = 自建中转。
SMS_DRIVER=console
# console 驱动下设为 1 时，发送验证码接口会直接回带 debugCode，仅限本地联调。
SMS_DEBUG=0
# 生产环境必须改成随机长字符串，否则验证码哈希盐是公开的。
SMS_HASH_SALT=change-me-to-a-random-secret
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ── 收款码 ──────────────────────────────────────────────────
# 图片放在 frontend/public/pay/，也可以填图床 URL。
PAY_WX_QR_URL=/pay/wx.png
PAY_WX_PAYEE=
PAY_ALIPAY_QR_URL=/pay/alipay.png
PAY_ALIPAY_PAYEE=
PAY_CONTACT=
# 1 = 用户点「我已付款」即自动开通。个人收款码没有回调，默认必须人工核对。
PAY_AUTO_APPROVE=0
